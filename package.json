{
  "name": "mcp-remote-template",
  "version": "1.0.0",
  "description": "Production-ready remote MCP server template: Streamable HTTP, built-in OAuth 2.1 (DCR + PKCE + consent), scoped tools, tests and one-click deploy.",
  "type": "module",
  "license": "MIT",
  "author": "Julian Coronel <https://github.com/julian7204>",
  "repository": {
    "type": "git",
    "url": "https://github.com/julian7204/mcp-remote-template.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oauth",
    "claude",
    "typescript",
    "template"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "express": "^5.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vitest": "^3.2.7"
  }
}
