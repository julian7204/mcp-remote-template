# Public URL where the server is reachable (no trailing slash). Used as OAuth issuer and resource id.
PUBLIC_URL=http://localhost:3000
PORT=3000
# Password shown on the consent screen. Anyone with it can authorize a client. Use 16+ random chars.
OWNER_PASSWORD=change-me-to-a-long-random-string
# Access token lifetime in seconds (default 3600) and refresh token lifetime (default 30 days).
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
# Set to 1 when running behind a reverse proxy (Render, Fly, Railway, nginx) so rate limiting sees real IPs.
TRUST_PROXY=0
